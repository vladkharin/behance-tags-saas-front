  "help": {
    "title": "How it works",
    "back": "← Back",
    "updated": "Manual updated: July 2026",
    "categories": [
      {
        "title": "📁 Project Management",
        "items": [
          {
            "q": "How to add a project?",
            "a": "Click 'New Project' in the sidebar. Paste your direct Behance link. Enter tags below. After clicking 'Launch', the robot will analyze your case."
          },
          {
            "q": "What do the sidebar statuses mean?",
            "a": "'In Queue' — waiting for parsing. 'Analyzing...' — scanning search results. 'Active' — data is ready."
          }
        ]
      },
      {
        "title": "📊 Interactive Chart",
        "items": [
          {
            "q": "How to read the chart?",
            "a": "The axis is inverted: the higher the dot, the better your rank (#1 is top). Upward line means your project is growing."
          },
          { "q": "How to see exact numbers?", "a": "Hover over any point to see the smart Tooltip with exact rankings for that date." }
        ]
      },
      {
        "title": "🔢 Tag Matrix",
        "items": [
          {
            "q": "Why use filters?",
            "a": "TOP-10 and Potential buttons allow you to instantly filter your best performing tags without searching through the entire list."
          },
          {
            "q": "How to copy tags?",
            "a": "Click 'Copy List' to grab all currently visible tags separated by commas. Perfect for pasting into new Behance cases."
          }
        ]
      },
      {
        "title": "🤖 Automation",
        "items": [
          {
            "q": "What does the Robot toggle do?",
            "a": "When Robot is ON, the system automatically updates your project rankings based on your plan schedule. If OFF — only manual updates."
          }
        ]
      }
    ]
  },
